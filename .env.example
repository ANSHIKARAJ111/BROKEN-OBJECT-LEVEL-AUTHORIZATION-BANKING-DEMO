PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

# AUTHZ_MODE controls whether GET /api/accounts/:id and
# GET /api/accounts/:id/transactions verify that the requested
# account belongs to the authenticated user.
#
#   vulnerable -> ownership check is SKIPPED (IDOR/BOLA demo)
#   secure     -> ownership check is ENFORCED (403 on mismatch)
AUTHZ_MODE=vulnerable
